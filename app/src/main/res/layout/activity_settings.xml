<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hp_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- Header: the same H mark as the launcher, a 1dp accent rule under it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="@color/hp_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/hp_accent_teal" />

        <!-- Connection -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_connection" />

        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_server"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_server" />

                    <TextView
                        android:id="@+id/text_server"
                        style="@style/SettingsValueMono"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_server_none" />
                </LinearLayout>

                <ImageView
                    style="@style/SettingsChevron"
                    android:contentDescription="@string/settings_change_server"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_probe"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_probe_label" />

                    <TextView
                        android:id="@+id/text_probe"
                        style="@style/SettingsValue"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_probe_idle" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsAction"
                    android:text="@string/settings_action_test" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_signout"
                style="@style/SettingsRow">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_sign_out"
                    android:textColor="@color/hp_error"
                    android:textSize="16sp" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsFooter"
                android:text="@string/settings_sign_out_hint" />
        </LinearLayout>

        <!-- Notifications -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_notifications" />

        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/notify_switch_label" />

                    <TextView
                        android:id="@+id/text_permission"
                        style="@style/SettingsValue"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_permission_unknown" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_notify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_test_notify"
                style="@style/SettingsRow">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/notify_test"
                    android:textColor="@color/hp_text_primary"
                    android:textSize="16sp" />

                <TextView
                    style="@style/SettingsAction"
                    android:text="@string/settings_action_send" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsFooter"
                android:text="@string/notify_switch_hint" />
        </LinearLayout>

        <!-- Device control -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_device" />

        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_device"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/shortcut_device_control" />

                    <TextView
                        android:id="@+id/text_device"
                        style="@style/SettingsValue"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_device_off" />
                </LinearLayout>

                <ImageView
                    style="@style/SettingsChevron"
                    android:contentDescription="@string/shortcut_device_control"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_battery"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsLabel"
                        android:text="@string/settings_battery_label" />

                    <TextView
                        android:id="@+id/text_battery"
                        style="@style/SettingsValue"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_battery_unknown" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsAction"
                    android:text="@string/settings_battery_allow" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsFooter"
                android:text="@string/settings_battery_hint" />
        </LinearLayout>

        <!-- About -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_section_about" />

        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_version" />

                <TextView
                    android:id="@+id/text_version"
                    style="@style/SettingsValueMono"
                    android:text="@string/settings_version_unknown" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/row_update"
                style="@style/SettingsRow">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_check_updates"
                    android:textColor="@color/hp_text_primary"
                    android:textSize="16sp" />

                <TextView
                    style="@style/SettingsAction"
                    android:text="@string/settings_action_check" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
